{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_TEST_ADS": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {},
    "testflight": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_TEST_ADS": "1"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6450523479"
      }
    }
  }
}
